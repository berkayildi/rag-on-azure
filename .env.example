# Application environment — shape only, no values.
# Copy to .env and fill in real endpoints; .env is gitignored.
# See AGENTS.md "Local dev tools" for the auth toggle behaviour.

# Azure OpenAI (chat + embeddings) — managed-identity auth, no key.
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=embedding
AZURE_OPENAI_CHAT_DEPLOYMENT=chat

# Azure AI Search — managed-identity auth, no key.
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_INDEX_NAME=corpus

# Key Vault — holds the JWT signing public PEM as the jwt-signing-key secret.
KEY_VAULT_URI=https://your-kv.vault.azure.net

# Auth mode. true = unsigned-decode dev path; false = RS256 verification
# against the Key Vault key. Production should run with this set to false.
ENABLE_DEV_AUTH=true

LOG_LEVEL=INFO
